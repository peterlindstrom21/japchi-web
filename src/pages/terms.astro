---
import Base from '../layouts/Base.astro';
import {
  LEGAL_NAME, LEGAL_STATE, LEGAL_COUNTRY, GOVERNING_LAW,
  POSTAL_ADDRESS, CONTACT_EMAIL, CONTACT_PHONE, CONTACT_PHONE_E164,
} from '../data/legal';
const lastUpdated = '2026-09-21';
---
<Base
  title="Terms of Service — JopChi"
  description="JopChi Terms of Service: the rules for using the JopChi iOS app and jopchi.com, including accounts, purchases, and advertising."
>
  <article aria-labelledby="terms-heading">
    <!-- Draft notice -->
    <div class="draft-notice" role="alert" aria-live="polite">
      ⚠️ <strong>DRAFT — Pending Legal Review.</strong> This document has not yet
      been reviewed by legal counsel. Do not treat it as a final, binding
      agreement. One item is still marked <strong>[NEEDS INPUT]</strong> and
      needs filling before publication. Last updated: <time datetime={lastUpdated}>{lastUpdated}</time>.
    </div>

    <p class="section-label">Legal</p>
    <h1 id="terms-heading">Terms of Service</h1>
    <p class="page-intro">
      These Terms govern your use of the JopChi iOS application and the website
      at <a href="https://jopchi.com">jopchi.com</a> (together, the
      &ldquo;Service&rdquo;). By using the Service you agree to them. If you do
      not agree, please do not use the Service.
    </p>
    <p class="meta">
      Effective date: <time datetime={lastUpdated}>{lastUpdated}</time><br />
      Contact: <a href="mailto:support@jopchi.com">support@jopchi.com</a><br />
      See also our <a href="/privacy">Privacy Policy</a>.
    </p>

    <nav aria-label="Terms of service sections" class="toc">
      <h2 id="toc-heading">Contents</h2>
      <ol aria-labelledby="toc-heading">
        <li><a href="#section-who">1. Who We Are</a></li>
        <li><a href="#section-eligibility">2. Eligibility</a></li>
        <li><a href="#section-licence">3. Your Licence to Use JopChi</a></li>
        <li><a href="#section-accounts">4. Accounts</a></li>
        <li><a href="#section-acceptable-use">5. Acceptable Use</a></li>
        <li><a href="#section-advertising">6. Advertising</a></li>
        <li><a href="#section-purchases">7. Purchases</a></li>
        <li><a href="#section-ip">8. Intellectual Property</a></li>
        <li><a href="#section-availability">9. Availability &amp; Changes</a></li>
        <li><a href="#section-disclaimer">10. Disclaimers</a></li>
        <li><a href="#section-liability">11. Limitation of Liability</a></li>
        <li><a href="#section-termination">12. Termination</a></li>
        <li><a href="#section-apple">13. Apple App Store Terms</a></li>
        <li><a href="#section-law">14. Governing Law</a></li>
        <li><a href="#section-changes">15. Changes to These Terms</a></li>
        <li><a href="#section-contact">16. Contact</a></li>
      </ol>
    </nav>

    <section aria-labelledby="section-who">
      <h2 id="section-who">1. Who We Are</h2>
      <div class="card">
        <p>
          JopChi is an independent iOS game published by <strong>{LEGAL_NAME}</strong>,
          an individual based in {LEGAL_STATE}, {LEGAL_COUNTRY}. These Terms are
          an agreement between you and {LEGAL_NAME}.
        </p>
        <address class="legal-address">
          {LEGAL_NAME}<br />
          {POSTAL_ADDRESS && <Fragment>{POSTAL_ADDRESS}<br /></Fragment>}
          {CONTACT_PHONE && CONTACT_PHONE_E164 && (
            <Fragment><a href={`tel:${CONTACT_PHONE_E164}`}>{CONTACT_PHONE}</a><br /></Fragment>
          )}
          <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
        </address>
        {(!POSTAL_ADDRESS || !CONTACT_PHONE) && (
          <p class="needs-input" role="note">
            <strong>[NEEDS INPUT]</strong> — a postal address and telephone
            number are still to be added, pending a decision on whether to use
            a business address and number rather than personal ones. Both are
            needed before release: GDPR Article 13 requires the controller's
            contact details, EU consumer rules expect a trader to be reachable
            other than by email, and Apple verifies and publishes a trader's
            name, address, phone and email on the EU App Store product page
            under Digital Services Act Articles 30-31.
          </p>
        )}
      </div>
    </section>

    <section aria-labelledby="section-eligibility">
      <h2 id="section-eligibility">2. Eligibility</h2>
      <div class="card">
        <p>
          JopChi is not directed at children under 13, and we do not knowingly
          collect personal information from them. If you are under the age of
          majority where you live, you may use the Service only with the
          involvement of a parent or guardian.
        </p>
      </div>
    </section>

    <section aria-labelledby="section-licence">
      <h2 id="section-licence">3. Your Licence to Use JopChi</h2>
      <div class="card">
        <p>
          We grant you a personal, non-exclusive, non-transferable, revocable
          licence to use the Service for your own non-commercial enjoyment. We
          retain all rights not expressly granted.
        </p>
      </div>
    </section>

    <section aria-labelledby="section-accounts">
      <h2 id="section-accounts">4. Accounts</h2>
      <div class="card">
        <p>
          You can play as a guest. Creating an account — through Sign in with
          Apple, Google, or Facebook — lets you sync your streak and statistics
          across devices. You are responsible for activity under your account,
          and for keeping access to the sign-in method you chose.
        </p>
        <p>
          You may delete your account and its associated data at any time by
          emailing <a href="mailto:support@jopchi.com">support@jopchi.com</a>.
          How we handle that data is described in our <a href="/privacy">Privacy Policy</a>.
        </p>
      </div>
    </section>

    <section aria-labelledby="section-acceptable-use">
      <h2 id="section-acceptable-use">5. Acceptable Use</h2>
      <div class="card">
        <p>You agree not to:</p>
        <ul>
          <li>Reverse engineer, decompile, or tamper with the app, except where that right cannot lawfully be restricted</li>
          <li>Automate play, manipulate scores or streaks, or interfere with the puzzle schedule</li>
          <li>Use the Service to break the law, or to disrupt it for other players</li>
          <li>Resell, redistribute, or commercially exploit any part of the Service</li>
        </ul>
      </div>
    </section>

    <section aria-labelledby="section-advertising">
      <h2 id="section-advertising">6. Advertising</h2>
      <div class="card">
        <p>
          The Service may display advertising supplied by third-party
          advertising networks. Where advertising is shown, those networks
          operate under their own terms and privacy policies, and may ask for
          your consent before showing personalised ads.
        </p>
        <p>
          You can remove advertising permanently through the in-app purchase
          described in section 7.
        </p>
        <p>
          What those networks collect, and how to refuse personalised
          advertising without losing access to the game, is described in our <a href="/privacy#section-ads">Privacy Policy</a>.
        </p>
      </div>
    </section>

    <section aria-labelledby="section-purchases">
      <h2 id="section-purchases">7. Purchases</h2>
      <div class="card">
        <p>
          JopChi offers a one-time, non-consumable in-app purchase that
          permanently removes advertising. All purchases are processed by Apple
          through the App Store — we never receive or store your payment
          details.
        </p>
        <p>
          Because Apple handles billing, <strong>refunds are requested from
          Apple</strong>, not from us, under the App Store's refund policy. EU
          consumers ordinarily have a 14-day right to withdraw from a digital
          purchase; because this content is delivered in full the moment it is
          bought, that right may be lost once delivery begins, and Apple's own
          process is where any such request is made.
          Restoring a previous purchase on a new device is done through the
          app's restore function using the same Apple Account.
        </p>
      </div>
    </section>

    <section aria-labelledby="section-ip">
      <h2 id="section-ip">8. Intellectual Property</h2>
      <div class="card">
        <p>
          JopChi, its name, artwork, soundtrack, puzzle content, and software
          are owned by us or our licensors and are protected by copyright and
          other laws. Results you share — the shapes grid and your score — are
          yours to post wherever you like.
        </p>
      </div>
    </section>

    <section aria-labelledby="section-availability">
      <h2 id="section-availability">9. Availability &amp; Changes</h2>
      <div class="card">
        <p>
          JopChi runs two scheduled games each day in US Pacific time. We aim to
          keep that schedule, but we do not guarantee uninterrupted availability
          and may change, suspend, or discontinue any part of the Service. We
          will give reasonable notice of material changes where we can.
        </p>
      </div>
    </section>

    <section aria-labelledby="section-disclaimer">
      <h2 id="section-disclaimer">10. Disclaimers</h2>
      <div class="card">
        <p>
          The Service is provided &ldquo;as is&rdquo; and &ldquo;as
          available&rdquo;, without warranties of any kind to the fullest extent
          permitted by law. We do not warrant that the Service will be
          error-free, that streaks and statistics will never be lost, or that
          defects will be corrected.
        </p>
        <p>
          Nothing in these Terms limits rights you have as a consumer that
          cannot be limited by agreement.
        </p>
      </div>
    </section>

    <section aria-labelledby="section-liability">
      <h2 id="section-liability">11. Limitation of Liability</h2>
      <div class="card">
        <p>
          To the fullest extent permitted by law, we are not liable for
          indirect, incidental, special, or consequential damages, or for lost
          data, streaks, or statistics.
        </p>
        <p>
          Where liability cannot be excluded, it is limited to the total amount
          you paid us for the Service in the twelve months before the claim
          arose. For a player who has never purchased anything that amount is
          zero; for someone who bought Remove Ads it is the price of that
          purchase.
        </p>
        <p>
          None of this limits liability that cannot lawfully be limited &mdash;
          including for death or personal injury caused by negligence, for
          fraud, or under the mandatory consumer protections described in
          section 14.
        </p>
      </div>
    </section>

    <section aria-labelledby="section-termination">
      <h2 id="section-termination">12. Termination</h2>
      <div class="card">
        <p>
          You may stop using the Service at any time and delete your account as
          described in section 4. We may suspend or terminate access if these
          Terms are breached. A validly completed purchase is not revoked by
          termination except where required by law or the App Store's rules.
        </p>
      </div>
    </section>

    <section aria-labelledby="section-apple">
      <h2 id="section-apple">13. Apple App Store Terms</h2>
      <div class="card">
        <p>
          These Terms are between you and us, <strong>not with Apple</strong>.
          Apple is not responsible for the Service or its content, and has no
          obligation to provide support or maintenance for it.
        </p>
        <p>
          If the app fails to conform to any applicable warranty, you may notify
          Apple, and Apple may refund the purchase price; to the maximum extent
          permitted by law, Apple has no other warranty obligation. Apple is not
          responsible for addressing any claim relating to the app, including
          product liability, regulatory non-compliance, or intellectual property
          claims.
        </p>
        <p>
          Apple and its subsidiaries are third-party beneficiaries of these
          Terms and may enforce them against you.
        </p>
      </div>
    </section>

    <section aria-labelledby="section-law">
      <h2 id="section-law">14. Governing Law</h2>
      <div class="card">
        <p>
          These Terms are governed by the laws of <strong>{GOVERNING_LAW}</strong>,
          without regard to its conflict-of-laws rules, and the state and
          federal courts located in California have jurisdiction over any
          dispute.
        </p>
        <p>
          That choice does not take away rights you already have. JopChi is
          offered in the EU and EEA, and if you are a consumer resident there
          the <strong>mandatory consumer protections of your own country still
          apply</strong> in full — a choice of California law cannot displace
          them. You may bring proceedings in the courts where you live, and you
          may raise a complaint with a consumer dispute body in your own country
          first. Nothing in these Terms asks you to give that up.
        </p>
      </div>
    </section>

    <section aria-labelledby="section-changes">
      <h2 id="section-changes">15. Changes to These Terms</h2>
      <div class="card">
        <p>
          We may update these Terms. When we do, we will revise the effective
          date at the top of this page. Continued use of the Service after a
          change takes effect constitutes acceptance of the updated Terms.
        </p>
      </div>
    </section>

    <section aria-labelledby="section-contact">
      <h2 id="section-contact">16. Contact</h2>
      <div class="card">
        <p>
          Questions about these Terms: <a href="mailto:support@jopchi.com">support@jopchi.com</a>
        </p>
        <p>
          Privacy and data requests: <a href="mailto:support@jopchi.com">support@jopchi.com</a>
        </p>
      </div>
    </section>
  </article>
</Base>

<style>
  article { max-width: 52rem; }

  .page-intro {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    margin: 1rem 0 1.5rem;
    max-width: 42rem;
  }

  .meta {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    line-height: 1.8;
  }

  .toc {
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin-bottom: 2.5rem;
  }

  .toc h2 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .toc ol {
    margin: 0;
    padding-left: 1.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.2rem 1rem;
  }

  .toc a { font-size: 0.9rem; } 

  section { margin-top: 2.5rem; } 
  section h2 { margin-bottom: 1rem; }

  .legal-address {
    font-style: normal;
    margin-top: 0.5rem;
    padding-left: 1rem;
    border-left: 2px solid var(--color-border);
    line-height: 1.7;
  }

  /* An item still awaiting a decision before publication — deliberately loud */
  .needs-input {
    margin-top: 1rem;
    padding: 0.875rem 1rem;
    border-left: 3px solid #fbbf24;
    background: rgba(251, 191, 36, 0.1);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    font-size: 0.9375rem;
    color: #fde68a;
  }
  .needs-input a { color: #fde68a; }
</style>
